#!/usr/bin/env bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source "$root/config.env"
export LIBBOX_TAGS

output_dir=${OUTPUT_DIR:-$root/dist}

if [[ -z ${SING_BOX_DIR:-} ]]; then
  work_dir=$(mktemp -d "${BUILD_TMPDIR:-/dev/shm}/build-android.XXXXXX")
  source_dir="$work_dir/sing-box"
  trap 'rm -rf "$work_dir"' EXIT

  export GOCACHE="$work_dir/go-build"
  export GOMODCACHE="$work_dir/go-mod"
  export GOPATH="$work_dir/go"
  export GRADLE_USER_HOME="$work_dir/gradle"

  git clone \
    --branch "$SING_BOX_TAG" \
    --depth=1 \
    https://github.com/SagerNet/sing-box.git \
    "$source_dir"
  git -C "$source_dir" submodule update --init --depth=1 clients/android
  git -C "$source_dir/clients/android" fetch --depth=1 origin main
  git -C "$source_dir/clients/android" checkout --detach FETCH_HEAD
  git -C "$source_dir/clients/android" submodule update --init --recursive --depth=1
else
  source_dir=$SING_BOX_DIR
fi

android_version=$(sed -n 's/^VERSION_NAME=//p' "$source_dir/clients/android/version.properties")
if [[ v$android_version != "$SING_BOX_TAG" ]]; then
  printf 'Android client %s does not match sing-box %s\n' "$android_version" "$SING_BOX_TAG" >&2
  exit 1
fi

apply_patches() {
  local source=$1 patch_dir=$2 patch

  while IFS= read -r -d '' patch; do
    git -C "$source" apply "$patch"
  done < <(find "$patch_dir" -type f -name '*.patch' -print0 | sort -z)
}

patch_modules() {
  local patch_dir module module_dir

  [[ -d $root/patches/modules ]] || return
  while IFS= read -r -d '' patch_dir; do
    module=${patch_dir#"$root/patches/modules/"}
    module_dir=$(mktemp -d "${RUNNER_TEMP:-$work_dir}/${module##*/}.XXXXXX")
    go mod download "$module"
    cp -a "$(go list -m -f '{{.Dir}}' "$module")/." "$module_dir/"
    chmod -R u+w "$module_dir"
    apply_patches "$module_dir" "$patch_dir"
    go mod edit -replace "$module=$module_dir"
  done < <(find "$root/patches/modules" -type f -name '*.patch' -printf '%h\0' | sort -zu)
}

apply_patches "$source_dir" "$root/patches/sing-box"
apply_patches "$source_dir/clients/android" "$root/patches/android"

cd "$source_dir"
patch_modules

gomobile_version=$(go list -m -f '{{.Version}}' github.com/sagernet/gomobile)
go install github.com/sagernet/gomobile/cmd/gomobile@"$gomobile_version"
go install github.com/sagernet/gomobile/cmd/gobind@"$gomobile_version"

"$(go env GOPATH)/bin/gomobile" bind \
  -v \
  -o libbox.aar \
  -target android \
  -androidapi "$(awk '/AndroidAPI:/ { api = $2 } /OutputName: "libbox.aar"/ { sub(/,$/, "", api); print api; exit }' cmd/internal/build_libbox/main.go)" \
  -javapkg io.nekohasekai \
  -libname box \
  -trimpath \
  -buildvcs=false \
  -tags "$LIBBOX_TAGS" \
  -ldflags "-X github.com/sagernet/sing-box/constant.Version=${SING_BOX_TAG#v} $(<release/LDFLAGS) -s -w -buildid=" \
  ./experimental/libbox

mkdir -p clients/android/app/libs
cp libbox.aar clients/android/app/libs/

cd clients/android
export SFA_UPDATE_REPOSITORY=${SFA_UPDATE_REPOSITORY:-${GITHUB_REPOSITORY:?Set SFA_UPDATE_REPOSITORY outside GitHub Actions}}
./gradlew \
  --build-cache \
  --parallel \
  ":app:assemble${SFA_FLAVOR^}${SFA_BUILD_TYPE^}"

mkdir -p "$output_dir"
cp app/build/outputs/apk/"$SFA_FLAVOR"/"$SFA_BUILD_TYPE"/*.apk "$output_dir/"
cp "$source_dir/libbox.aar" "$output_dir/"
printf '{\n  "version_code": %s,\n  "version_name": "%s"\n}\n' \
  "$(sed -n 's/^VERSION_CODE=//p' version.properties)" \
  "$(sed -n 's/^VERSION_NAME=//p' version.properties)" \
  > "$output_dir/SFA-version-metadata.json"
sha256sum "$output_dir"/* > "$output_dir/SHA256SUMS"
