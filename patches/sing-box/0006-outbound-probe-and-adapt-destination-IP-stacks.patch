--- /dev/null
+++ b/common/urltest/history.go
@@ -0,0 +1,112 @@
+package urltest
+
+import (
+	"maps"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/observable"
+)
+
+type HistoryStorage struct {
+	access       sync.RWMutex
+	delayHistory map[string]*adapter.URLTestHistory
+	ipStacks     map[string]adapter.OutboundIPStack
+	updateHooks  []*observable.Subscriber[struct{}]
+}
+
+func NewHistoryStorage() *HistoryStorage {
+	return &HistoryStorage{
+		delayHistory: make(map[string]*adapter.URLTestHistory),
+		ipStacks:     make(map[string]adapter.OutboundIPStack),
+	}
+}
+
+func (s *HistoryStorage) AddUpdateHook(hook *observable.Subscriber[struct{}]) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.updateHooks = append(s.updateHooks, hook)
+}
+
+func (s *HistoryStorage) NotifyUpdated() {
+	s.access.RLock()
+	defer s.access.RUnlock()
+	s.notifyUpdated()
+}
+
+func (s *HistoryStorage) LoadURLTestHistory(tag string) *adapter.URLTestHistory {
+	if s == nil {
+		return nil
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	return s.delayHistory[tag]
+}
+
+func (s *HistoryStorage) DeleteURLTestHistory(tag string) {
+	s.access.Lock()
+	delete(s.delayHistory, tag)
+	s.notifyUpdated()
+	s.access.Unlock()
+}
+
+func (s *HistoryStorage) StoreURLTestHistory(tag string, history *adapter.URLTestHistory) {
+	s.access.Lock()
+	s.delayHistory[tag] = history
+	s.notifyUpdated()
+	s.access.Unlock()
+}
+
+func (s *HistoryStorage) UpdateURLTestHistory(stored map[string]*adapter.URLTestHistory, deleted []string) {
+	s.access.Lock()
+	defer s.access.Unlock()
+	for _, tag := range deleted {
+		delete(s.delayHistory, tag)
+	}
+	maps.Copy(s.delayHistory, stored)
+}
+
+func (s *HistoryStorage) notifyUpdated() {
+	for _, updateHook := range s.updateHooks {
+		updateHook.Emit(struct{}{})
+	}
+}
+
+func (s *HistoryStorage) Close() error {
+	s.access.Lock()
+	defer s.access.Unlock()
+	s.updateHooks = nil
+	return nil
+}
+
+func (s *HistoryStorage) LoadIPStack(tag string) (adapter.OutboundIPStack, bool) {
+	if s == nil {
+		return adapter.OutboundIPStack{}, false
+	}
+	s.access.RLock()
+	defer s.access.RUnlock()
+	capabilities, loaded := s.ipStacks[tag]
+	return capabilities, loaded
+}
+
+func (s *HistoryStorage) StoreIPStack(tag string, network string, capabilities adapter.IPStackCapabilities) {
+	s.access.Lock()
+	value := s.ipStacks[tag]
+	switch network {
+	case N.NetworkTCP:
+		value.TCP = capabilities
+	case N.NetworkUDP:
+		value.UDP = capabilities
+	}
+	s.ipStacks[tag] = value
+	s.access.Unlock()
+}
+
+func (s *HistoryStorage) LoadOutboundIPStack(outbound adapter.Outbound) (adapter.OutboundIPStack, bool) {
+	_, tcpTag, _ := testOutbound(outbound, N.NetworkTCP)
+	_, udpTag, _ := testOutbound(outbound, N.NetworkUDP)
+	tcp, tcpLoaded := s.LoadIPStack(tcpTag)
+	udp, udpLoaded := s.LoadIPStack(udpTag)
+	return adapter.OutboundIPStack{TCP: tcp.TCP, UDP: udp.UDP}, tcpLoaded || udpLoaded
+}
