+func TestDNSAddressAssociation(t *testing.T) {
+	router := &Router{
+		addressMapping: common.Must1(freelru.New[netip.Addr, dnsAddressMapping](16, maphash.NewHasher[netip.Addr]().Hash32, true)),
+	}
+	message := new(mDNS.Msg)
+	message.SetQuestion("www.example.", mDNS.TypeA)
+	message.SetEdns0(1232, true)
+	message.CheckingDisabled = true
+	response := new(mDNS.Msg)
+	response.SetReply(message)
+	response.Answer = []mDNS.RR{
+		&mDNS.CNAME{Hdr: mDNS.RR_Header{Name: "www.example.", Rrtype: mDNS.TypeCNAME, Class: mDNS.ClassINET, Ttl: 60}, Target: "cdn.example."},
+		&mDNS.A{Hdr: mDNS.RR_Header{Name: "cdn.example.", Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 3600}, A: netip.MustParseAddr("192.0.2.1").AsSlice()},
+	}
+	router.recordAddressMapping(message, response, &relatedAddressTransport{}, adapter.DNSQueryOptions{})
+	ip := netip.MustParseAddr("192.0.2.1")
+	mapping, loaded := router.addressMapping.Get(ip)
+	if !loaded || mapping.query.Question[0].Name != "www.example." {
+		t.Fatalf("original DNS question was lost: %+v", mapping)
+	}
+	if !mapping.query.IsEdns0().Do() || !mapping.query.CheckingDisabled || mapping.query.IsEdns0().UDPSize() != 1232 {
+		t.Fatal("DNS query flags were lost")
+	}
+	message.Question[0].Name = "changed.example."
+	message.IsEdns0().SetUDPSize(512)
+	if mapping.query.Question[0].Name != "www.example." || mapping.query.IsEdns0().UDPSize() != 1232 {
+		t.Fatal("DNS association retained a mutable caller query")
+	}
+	if _, loaded := router.LookupReverseMapping(ip); loaded {
+		t.Fatal("internal association enabled public reverse mapping")
+	}
+	router.dnsReverseMapping = common.Must1(freelru.New[netip.Addr, string](16, maphash.NewHasher[netip.Addr]().Hash32, true))
+	router.dnsECHPublicNames = common.Must1(freelru.New[string, string](16, maphash.NewHasher[string]().Hash32, true))
+	router.recordReverseMapping(mapping.query, response, nil)
+	if domain, loaded := router.LookupReverseMapping(ip); !loaded || domain != "www.example" {
+		t.Fatal("public reverse mapping changed its domain semantics")
+	}
+}
+
+func TestAddressAssociationRespectsDisabledReverseMapping(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		router := &Router{
+			addressMapping: common.Must1(freelru.New[netip.Addr, dnsAddressMapping](16, maphash.NewHasher[netip.Addr]().Hash32, true)),
+		}
+		query := new(mDNS.Msg)
+		query.SetQuestion("www.example.", mDNS.TypeA)
+		address := netip.MustParseAddr("192.0.2.1")
+		response := FixedResponse(query.Id, query.Question[0], []netip.Addr{address}, 60)
+		router.finishExchangeAsync(query, adapter.DNSQueryOptions{DisableReverseMapping: disabled}, exchangeWithRulesResult{
+			response:  response,
+			transport: &relatedAddressTransport{},
+		}, func(actual *mDNS.Msg, err error) {
+			if actual != response || err != nil {
+				t.Fatalf("unexpected response: %v, %v", actual, err)
+			}
+		})
+		if _, loaded := router.addressMapping.Get(address); loaded == disabled {
+			t.Fatalf("association present = %v, DisableReverseMapping = %v", loaded, disabled)
+		}
+	}
+}
+
+type relatedAddressTransport struct {
+	adapter.DNSTransport
+	queried chan mDNS.Question
+	address netip.Addr
+}
+
+func (*relatedAddressTransport) Type() string { return "test" }
+
+func (*relatedAddressTransport) Tag() string { return "test" }
+
+func (t *relatedAddressTransport) Exchange(_ context.Context, message *mDNS.Msg) (*mDNS.Msg, error) {
+	if t.queried != nil {
+		t.queried <- message.Question[0]
+	}
+	if t.address.IsValid() {
+		return FixedResponse(message.Id, message.Question[0], []netip.Addr{t.address}, 60), nil
+	}
+	return nil, context.DeadlineExceeded
+}
+
+type ipStackDNSCache struct {
+	adapter.DNSCacheStore
+	question mDNS.Question
+	message  []byte
+	expires  time.Time
+}
+
+func (c *ipStackDNSCache) LoadDNSCache(_ string, name string, qType uint16) ([]byte, time.Time, bool) {
+	if name != c.question.Name || qType != c.question.Qtype {
+		return nil, time.Time{}, false
+	}
+	return c.message, c.expires, true
+}
