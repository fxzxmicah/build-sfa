+package urltest
+
+import (
+	"context"
+	"crypto/tls"
+	"net/http"
+	"time"
+
+	"github.com/sagernet/quic-go/http3"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/networkquality"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/common/ntp"
+)
+
+func udpURLTest(ctx context.Context, request *http.Request, destination M.Socksaddr, detour N.Dialer) (uint16, error) {
+	factory, err := networkquality.NewHTTP3MeasurementClientFactory(detour)
+	if err != nil {
+		return 0, err
+	}
+	client, err := factory(destination.String(), true, true, nil, nil)
+	if err != nil {
+		return 0, err
+	}
+	transport := client.Transport.(*http3.Transport)
+	transport.TLSClientConfig = &tls.Config{
+		Time:    ntp.TimeFuncFromContext(ctx),
+		RootCAs: adapter.RootPoolFromContext(ctx),
+	}
+	defer transport.Close()
+	client.Timeout = C.TCPTimeout
+	client.CheckRedirect = func(req *http.Request, via []*http.Request) error {
+		return http.ErrUseLastResponse
+	}
+	start := time.Now()
+	response, err := client.Do(request.Clone(ctx))
+	if err != nil {
+		return 0, err
+	}
+	response.Body.Close()
+	return uint16(max(1, time.Since(start).Milliseconds())), nil
+}
