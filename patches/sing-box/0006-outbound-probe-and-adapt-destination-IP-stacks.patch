+func (c *ipStackDNSCache) SaveDNSCacheAsync(string, string, uint16, []byte, time.Time, logger.Logger) {
+}
+
+func TestRelatedAddressCachePolicy(t *testing.T) {
+	for _, test := range []struct {
+		name       string
+		cache      bool
+		age        time.Duration
+		client     ClientOptions
+		query      adapter.DNSQueryOptions
+		dnssec     bool
+		sourceTTL  uint32
+		cached     bool
+		refresh    bool
+	}{
+		{name: "no cache entry"},
+		{name: "fresh", cache: true, age: -time.Hour, cached: true},
+		{name: "expired", cache: true, age: time.Minute},
+		{name: "optimistic", cache: true, age: time.Minute, client: ClientOptions{OptimisticTimeout: time.Hour}, cached: true, refresh: true},
+		{name: "optimistic expired", cache: true, age: 2 * time.Hour, client: ClientOptions{OptimisticTimeout: time.Hour}},
+		{name: "query disables optimistic", cache: true, age: time.Minute, client: ClientOptions{OptimisticTimeout: time.Hour}, query: adapter.DNSQueryOptions{DisableOptimisticCache: true}},
+		{name: "expiration disabled", cache: true, age: 2 * time.Hour, client: ClientOptions{DisableExpire: true}, cached: true},
+		{name: "cache disabled", cache: true, age: -time.Hour, client: ClientOptions{DisableCache: true}},
+		{name: "query disables cache", cache: true, age: -time.Hour, query: adapter.DNSQueryOptions{DisableCache: true}},
+		{name: "uncacheable query", cache: true, age: -time.Hour, dnssec: true},
+		{name: "source TTL elapsed", sourceTTL: 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			query := new(mDNS.Msg)
+			query.SetQuestion("www.example.", mDNS.TypeA)
+			if test.dnssec {
+				query.SetEdns0(1232, true)
+			}
+			options := test.client
+			options.Context = context.Background()
+			client := NewClient(options)
+			cachedAddress := netip.MustParseAddr("2001:db8::1")
+			liveAddress := netip.MustParseAddr("2001:db8::2")
+			if test.cache {
+				opposite := mDNS.Question{Name: query.Question[0].Name, Qtype: mDNS.TypeAAAA, Qclass: mDNS.ClassINET}
+				response := FixedResponse(query.Id, opposite, []netip.Addr{cachedAddress}, 60)
+				raw, err := response.Pack()
+				if err != nil {
+					t.Fatal(err)
+				}
+				client.dnsCache = &ipStackDNSCache{
+					question: opposite,
+					message:  raw,
+					expires:  time.Now().Add(-test.age),
+				}
+			}
+			transport := &relatedAddressTransport{
+				queried: make(chan mDNS.Question, 1),
+				address: liveAddress,
+			}
+			router := &Router{
+				client:         client,
+				addressMapping: common.Must1(freelru.New[netip.Addr, dnsAddressMapping](16, maphash.NewHasher[netip.Addr]().Hash32, true)),
+			}
+			original := netip.MustParseAddr("192.0.2.1")
+			answer := FixedResponse(query.Id, query.Question[0], []netip.Addr{original}, test.sourceTTL)
+			router.recordAddressMapping(query, answer, transport, test.query)
+			if test.sourceTTL > 0 {
+				time.Sleep(time.Duration(test.sourceTTL)*time.Second + time.Millisecond)
+			}
+			addresses, err := router.LookupRelatedAddresses(context.Background(), original)
+			expected := liveAddress
+			if test.cached {
+				expected = cachedAddress
+			}
+			if err != nil || len(addresses) != 1 || addresses[0] != expected {
+				t.Fatalf("related addresses = %v, %v; want %v", addresses, err, expected)
+			}
+			if !test.cached || test.refresh {
+				select {
+				case question := <-transport.queried:
+					if question.Name != query.Question[0].Name || question.Qtype != mDNS.TypeAAAA {
+						t.Fatal("adaptation re-queried the source family or changed the domain")
+					}
+				case <-time.After(time.Second):
+					t.Fatal("expected the original DNS client to query the other family")
+				}
+			} else {
+				select {
+				case <-transport.queried:
+					t.Fatal("a valid cached answer started an unexpected query")
+				default:
+				}
+			}
+			if _, loaded := router.addressMapping.Get(expected); !loaded {
+				t.Fatal("supplemental answer did not update the association index")
+			}
+			if query.Question[0].Qtype != mDNS.TypeA {
+				t.Fatal("adaptation changed the original query")
+			}
+		})
+	}
+}
+
+type relatedAddressClient struct {
+	adapter.DNSClient
+	exchange func(context.Context, adapter.DNSTransport, *mDNS.Msg, adapter.DNSQueryOptions, func(*mDNS.Msg) bool) (*mDNS.Msg, error)
+}
+
+func (c *relatedAddressClient) Exchange(ctx context.Context, transport adapter.DNSTransport, message *mDNS.Msg, options adapter.DNSQueryOptions, check func(*mDNS.Msg) bool) (*mDNS.Msg, error) {
+	return c.exchange(ctx, transport, message, options, check)
+}
+
+func TestRelatedAddressUsesResolvedQuery(t *testing.T) {
+	transport := &relatedAddressTransport{}
+	ttl := uint32(30)
+	options := adapter.DNSQueryOptions{
+		DisableCache:           true,
+		DisableOptimisticCache: true,
+		RewriteTTL:             &ttl,
+		Timeout:                time.Second,
+		ClientSubnet:           netip.MustParsePrefix("192.0.2.0/24"),
+	}
+	router := &Router{
+		addressMapping: common.Must1(freelru.New[netip.Addr, dnsAddressMapping](16, maphash.NewHasher[netip.Addr]().Hash32, true)),
+	}
+	query := new(mDNS.Msg)
+	query.SetQuestion("www.example.", mDNS.TypeA)
+	query.SetEdns0(1232, false)
+	query.CheckingDisabled = true
+	answer := new(mDNS.Msg)
+	answer.SetReply(query)
+	answer.Answer = []mDNS.RR{
+		&mDNS.A{Hdr: mDNS.RR_Header{Name: "www.example.", Rrtype: mDNS.TypeA, Class: mDNS.ClassINET, Ttl: 30}, A: netip.MustParseAddr("192.0.2.1").AsSlice()},
+	}
+	router.recordAddressMapping(query, answer, transport, options)
+	router.client = &relatedAddressClient{exchange: func(ctx context.Context, actual adapter.DNSTransport, message *mDNS.Msg, actualOptions adapter.DNSQueryOptions, check func(*mDNS.Msg) bool) (*mDNS.Msg, error) {
+		if actual != transport || actualOptions != options || check != nil {
+			t.Fatal("related query did not reuse the resolved DNS exchange")
+		}
+		if message.Question[0].Name != "www.example." || message.Question[0].Qtype != mDNS.TypeAAAA || !message.CheckingDisabled || message.IsEdns0() == nil || message.IsEdns0().Do() {
+			t.Fatal("related query lost the original question or flags")
+		}
+		response := new(mDNS.Msg)
+		response.SetReply(message)
+		response.Answer = []mDNS.RR{
+			&mDNS.AAAA{Hdr: mDNS.RR_Header{Name: "www.example.", Rrtype: mDNS.TypeAAAA, Class: mDNS.ClassINET, Ttl: 30}, AAAA: netip.MustParseAddr("2001:db8::1").AsSlice()},
+		}
+		return response, nil
+	}}
+	addresses, err := router.LookupRelatedAddresses(context.Background(), netip.MustParseAddr("192.0.2.1"))
+	if err != nil || len(addresses) != 1 || addresses[0] != netip.MustParseAddr("2001:db8::1") {
+		t.Fatalf("unexpected related addresses: %v, %v", addresses, err)
+	}
+	if _, loaded := router.addressMapping.Get(addresses[0]); !loaded {
+		t.Fatal("supplemental DNS answer did not create an address association")
+	}
+	if query.Question[0].Qtype != mDNS.TypeA {
+		t.Fatal("supplemental query modified the original question")
+	}
+}
