+func http3Port(header http.Header, hostname string) (uint16, bool) {
+	for _, value := range header.Values("Alt-Svc") {
+		for _, alternative := range strings.Split(value, ",") {
+			service, _, _ := strings.Cut(alternative, ";")
+			protocol, authority, found := strings.Cut(service, "=")
+			if !found || strings.TrimSpace(protocol) != "h3" {
+				continue
+			}
+			authority, err := strconv.Unquote(strings.TrimSpace(authority))
+			if err != nil {
+				continue
+			}
+			host, port, err := net.SplitHostPort(authority)
+			if err != nil || (host != "" && !strings.EqualFold(host, hostname)) {
+				continue
+			}
+			portNumber, err := strconv.ParseUint(port, 10, 16)
+			if err == nil && portNumber > 0 {
+				return uint16(portNumber), true
+			}
+		}
 	}
