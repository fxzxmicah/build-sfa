@@ -0,0 +1,91 @@
+package route
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type ipStackTestDNS struct {
+	adapter.DNSRouter
+	queried   netip.Addr
+	addresses []netip.Addr
+}
+
+func (d *ipStackTestDNS) LookupRelatedAddresses(ctx context.Context, ip netip.Addr) ([]netip.Addr, error) {
+	d.queried = ip
+	return d.addresses, nil
+}
+
+type ipStackTestOutbound struct {
+	adapter.Outbound
+	outboundType string
+}
+
+func (o ipStackTestOutbound) Tag() string { return "node" }
+
+func (o ipStackTestOutbound) Type() string { return o.outboundType }
+
+func TestAdaptIPStack(t *testing.T) {
+	for _, network := range []string{N.NetworkTCP, N.NetworkUDP} {
+		t.Run(network, func(t *testing.T) {
+			history := urltest.NewHistoryStorage()
+			history.StoreIPStack("node", network, adapter.IPStackCapabilities{
+				IPv4: adapter.IPStackUnavailable,
+				IPv6: adapter.IPStackAvailable,
+			})
+			dns := &ipStackTestDNS{addresses: []netip.Addr{netip.MustParseAddr("2001:db8::1")}}
+			router := &Router{dns: dns, urlTestHistory: history, logger: log.NewNOPFactory().NewLogger("router")}
+			original := M.ParseSocksaddr("192.0.2.1:443")
+			metadata := adapter.InboundContext{Network: network, Destination: original, Domain: "unrelated.sniff.example"}
+			router.adaptIPStack(context.Background(), &metadata, ipStackTestOutbound{outboundType: C.TypeVLESS})
+			if metadata.Destination != M.ParseSocksaddr("[2001:db8::1]:443") || metadata.IPVersion != 6 {
+				t.Fatalf("unexpected dial destination: %+v", metadata.Destination)
+			}
+			if metadata.RouteOriginalDestination != original || dns.queried != original.Addr {
+				t.Fatal("DNS association or original packet destination was lost")
+			}
+			overridden := M.ParseSocksaddr("198.51.100.1:80")
+			metadata.Destination = original
+			metadata.RouteOriginalDestination = overridden
+			router.adaptIPStack(context.Background(), &metadata, ipStackTestOutbound{outboundType: C.TypeVLESS})
+			if metadata.RouteOriginalDestination != overridden {
+				t.Fatal("an existing destination override was replaced")
+			}
+		})
+	}
+}
+
+func TestIPStackAdaptationPreservesUnmatchedConnections(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		outboundType string
+		fakeIP       bool
+		capabilities adapter.IPStackCapabilities
+	}{
+		{"unknown", C.TypeVLESS, false, adapter.IPStackCapabilities{}},
+		{"matching", C.TypeVLESS, false, adapter.IPStackCapabilities{IPv4: adapter.IPStackAvailable, IPv6: adapter.IPStackAvailable}},
+		{"direct", C.TypeDirect, false, adapter.IPStackCapabilities{IPv4: adapter.IPStackUnavailable, IPv6: adapter.IPStackAvailable}},
+		{"fakeip", C.TypeVLESS, true, adapter.IPStackCapabilities{IPv4: adapter.IPStackUnavailable, IPv6: adapter.IPStackAvailable}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			history := urltest.NewHistoryStorage()
+			history.StoreIPStack("node", N.NetworkTCP, test.capabilities)
+			dns := &ipStackTestDNS{}
+			router := &Router{dns: dns, urlTestHistory: history, logger: log.NewNOPFactory().NewLogger("router")}
+			original := M.ParseSocksaddr("192.0.2.1:443")
+			metadata := adapter.InboundContext{Network: N.NetworkTCP, Destination: original, FakeIP: test.fakeIP}
+			router.adaptIPStack(context.Background(), &metadata, ipStackTestOutbound{outboundType: test.outboundType})
+			if metadata.Destination != original || dns.queried.IsValid() {
+				t.Fatal("an unmatched connection was modified")
+			}
+		})
+	}
+}
