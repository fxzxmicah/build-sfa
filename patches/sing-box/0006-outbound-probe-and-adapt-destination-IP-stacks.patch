diff --git a/adapter/ip_stack.go b/adapter/ip_stack.go
new file mode 100644
index 0000000..0197c0b
--- /dev/null
+++ b/adapter/ip_stack.go
@@ -0,0 +1,58 @@
+package adapter
+
+import (
+	"net/netip"
+
+	N "github.com/sagernet/sing/common/network"
+)
+
+type IPStackStatus uint8
+
+const (
+	IPStackUnknown IPStackStatus = iota
+	IPStackAvailable
+	IPStackUnavailable
+)
+
+func (s IPStackStatus) String() string {
+	switch s {
+	case IPStackAvailable:
+		return "available"
+	case IPStackUnavailable:
+		return "unavailable"
+	default:
+		return "unknown"
+	}
+}
+
+func (s IPStackStatus) MarshalText() ([]byte, error) {
+	return []byte(s.String()), nil
+}
+
+type IPStackCapabilities struct {
+	IPv4 IPStackStatus `json:"ipv4"`
+	IPv6 IPStackStatus `json:"ipv6"`
+}
+
+func (c IPStackCapabilities) NeedsAdaptation(address netip.Addr) bool {
+	if address.Is4() {
+		return c.IPv4 == IPStackUnavailable && c.IPv6 == IPStackAvailable
+	}
+	return address.Is6() && c.IPv6 == IPStackUnavailable && c.IPv4 == IPStackAvailable
+}
+
+type OutboundIPStack struct {
+	TCP IPStackCapabilities `json:"tcp"`
+	UDP IPStackCapabilities `json:"udp"`
+}
+
+func (s OutboundIPStack) Network(network string) IPStackCapabilities {
+	switch network {
+	case N.NetworkTCP:
+		return s.TCP
+	case N.NetworkUDP:
+		return s.UDP
+	default:
+		return IPStackCapabilities{}
+	}
+}
diff --git a/adapter/ip_stack_test.go b/adapter/ip_stack_test.go
new file mode 100644
index 0000000..c6f012b
--- /dev/null
+++ b/adapter/ip_stack_test.go
@@ -0,0 +1,46 @@
+package adapter
+
+import (
+	"encoding/json"
+	"net/netip"
+	"testing"
+)
+
+func TestIPStackAdaptation(t *testing.T) {
+	for _, test := range []struct {
+		name    string
+		ipv4    IPStackStatus
+		ipv6    IPStackStatus
+		address string
+		adapt   bool
+	}{
+		{"unknown", IPStackUnknown, IPStackUnknown, "192.0.2.1", false},
+		{"unknown source", IPStackUnknown, IPStackAvailable, "192.0.2.1", false},
+		{"unknown alternative", IPStackUnavailable, IPStackUnknown, "192.0.2.1", false},
+		{"dual stack", IPStackAvailable, IPStackAvailable, "192.0.2.1", false},
+		{"both unavailable", IPStackUnavailable, IPStackUnavailable, "192.0.2.1", false},
+		{"IPv4 to IPv6", IPStackUnavailable, IPStackAvailable, "192.0.2.1", true},
+		{"IPv6 to IPv4", IPStackAvailable, IPStackUnavailable, "2001:db8::1", true},
+		{"IPv6 unchanged", IPStackUnavailable, IPStackAvailable, "2001:db8::1", false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			capabilities := IPStackCapabilities{IPv4: test.ipv4, IPv6: test.ipv6}
+			if got := capabilities.NeedsAdaptation(netip.MustParseAddr(test.address)); got != test.adapt {
+				t.Fatalf("NeedsAdaptation() = %v, want %v", got, test.adapt)
+			}
+		})
+	}
+}
+
+func TestIPStackRepresentation(t *testing.T) {
+	capabilities := OutboundIPStack{
+		TCP: IPStackCapabilities{IPv4: IPStackAvailable, IPv6: IPStackUnavailable},
+	}
+	data, err := json.Marshal(capabilities)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != `{"tcp":{"ipv4":"available","ipv6":"unavailable"},"udp":{"ipv4":"unknown","ipv6":"unknown"}}` {
+		t.Fatalf("unexpected capabilities: %s", data)
+	}
+}
diff --git a/common/urltest/history.go b/common/urltest/history.go
