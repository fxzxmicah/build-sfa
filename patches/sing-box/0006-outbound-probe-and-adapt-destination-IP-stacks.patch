@@ -0,0 +1,46 @@
+package route
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func (r *Router) needsIPStackAdaptation(metadata *adapter.InboundContext, outbound adapter.Outbound) bool {
+	if !metadata.Destination.IsIP() || metadata.FakeIP || outbound.Type() == C.TypeDirect {
+		return false
+	}
+	capabilities, loaded := r.urlTestHistory.LoadIPStack(outbound.Tag())
+	return loaded && capabilities.Network(metadata.Network).NeedsAdaptation(metadata.Destination.Addr)
+}
+
+func (r *Router) adaptIPStack(ctx context.Context, metadata *adapter.InboundContext, outbound adapter.Outbound) {
+	if !r.needsIPStackAdaptation(metadata, outbound) {
+		return
+	}
+	addresses, err := r.dns.LookupRelatedAddresses(adapter.WithContext(ctx, metadata), metadata.Destination.Addr)
+	if err != nil {
+		r.logger.DebugContext(ctx, "lookup related address: ", err)
+		return
+	}
+	for _, address := range addresses {
+		address = address.Unmap()
+		if address.Is4() == metadata.Destination.IsIPv4() {
+			continue
+		}
+		if !metadata.RouteOriginalDestination.IsValid() {
+			metadata.RouteOriginalDestination = metadata.Destination
+		}
+		metadata.Destination = M.SocksaddrFrom(address, metadata.Destination.Port)
+		metadata.DestinationAddresses = nil
+		if address.Is4() {
+			metadata.IPVersion = 4
+		} else {
+			metadata.IPVersion = 6
+		}
+		r.logger.DebugContext(ctx, "using related ", metadata.Network, " destination ", metadata.Destination)
+		return
+	}
+}
