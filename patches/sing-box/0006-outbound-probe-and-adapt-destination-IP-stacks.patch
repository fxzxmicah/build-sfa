@@ -0,0 +1,161 @@
+package urltest
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/netip"
+	"strings"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+func TestHTTP3Port(t *testing.T) {
+	for _, test := range []struct {
+		value      string
+		port       uint16
+		advertised bool
+	}{
+		{"", 0, false},
+		{"clear", 0, false},
+		{`h2=":443"`, 0, false},
+		{`h3=":443"; ma=86400`, 443, true},
+		{`h2=":443", h3=":8443"; ma=86400`, 8443, true},
+		{`h3="example.com:443"`, 443, true},
+		{`h3="different.example:443"`, 0, false},
+		{`h3=":65536"`, 0, false},
+		{`h3=":0"`, 0, false},
+	} {
+		t.Run(test.value, func(t *testing.T) {
+			header := make(http.Header)
+			header.Add("Alt-Svc", test.value)
+			port, advertised := http3Port(header, "example.com")
+			if port != test.port || advertised != test.advertised {
+				t.Fatalf("http3Port() = (%d, %v), want (%d, %v)", port, advertised, test.port, test.advertised)
+			}
+		})
+	}
+}
+
+func TestStackTestStatus(t *testing.T) {
+	for _, test := range []struct {
+		name   string
+		result stackTestResult
+		status adapter.IPStackStatus
+	}{
+		{"not tested", stackTestResult{}, adapter.IPStackUnknown},
+		{"success", stackTestResult{delay: 1}, adapter.IPStackAvailable},
+		{"failed HTTP", stackTestResult{err: errors.New("HTTP request failed")}, adapter.IPStackUnavailable},
+		{"failed HTTP3", stackTestResult{err: errors.New("HTTP3 request failed")}, adapter.IPStackUnavailable},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if status := test.result.status(); status != test.status {
+				t.Fatalf("status() = %s, want %s", status, test.status)
+			}
+		})
+	}
+}
+
+func TestIPStackHistory(t *testing.T) {
+	history := NewHistoryStorage()
+	history.StoreIPStack("node", N.NetworkTCP, adapter.IPStackCapabilities{
+		IPv4: adapter.IPStackAvailable,
+		IPv6: adapter.IPStackUnavailable,
+	})
+	history.StoreIPStack("node", N.NetworkUDP, adapter.IPStackCapabilities{
+		IPv4: adapter.IPStackUnavailable,
+		IPv6: adapter.IPStackAvailable,
+	})
+	history.DeleteURLTestHistory("node")
+	capabilities, loaded := history.LoadIPStack("node")
+	if !loaded || capabilities.TCP.IPv4 != adapter.IPStackAvailable || capabilities.UDP.IPv6 != adapter.IPStackAvailable {
+		t.Fatalf("capabilities lost when delay history changed: %+v", capabilities)
+	}
+	history.StoreIPStack("node", N.NetworkTCP, adapter.IPStackCapabilities{})
+	capabilities, _ = history.LoadIPStack("node")
+	if capabilities.TCP != (adapter.IPStackCapabilities{}) || capabilities.UDP.IPv6 != adapter.IPStackAvailable {
+		t.Fatalf("unexpected network update: %+v", capabilities)
+	}
+}
+
+type stackProbeDNS struct {
+	adapter.DNSRouter
+	dualStack bool
+	lookups   int
+}
+
+func (d *stackProbeDNS) Lookup(ctx context.Context, domain string, options adapter.DNSQueryOptions) ([]netip.Addr, error) {
+	d.lookups++
+	addresses := []netip.Addr{netip.MustParseAddr("192.0.2.1")}
+	if d.dualStack {
+		addresses = append(addresses, netip.MustParseAddr("2001:db8::1"))
+	}
+	return addresses, nil
+}
+
+type stackProbeDialer struct {
+	outbound.Adapter
+	target string
+}
+
+func (d *stackProbeDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	if destination.IsIPv6() {
+		return nil, errors.New("IPv6 unavailable")
+	}
+	var dialer net.Dialer
+	return dialer.DialContext(ctx, network, d.target)
+}
+
+func (d *stackProbeDialer) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	return nil, errors.New("unexpected packet listener")
+}
+
+func TestURLTestIPStacks(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		writer.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+	_, port, err := net.SplitHostPort(strings.TrimPrefix(server.URL, "http://"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	detour := &stackProbeDialer{
+		Adapter: outbound.NewAdapter(C.TypeVLESS, "node", []string{N.NetworkTCP, N.NetworkUDP}, nil),
+		target:  server.Listener.Addr().String(),
+	}
+	for _, dualStack := range []bool{false, true} {
+		history := NewHistoryStorage()
+		dns := &stackProbeDNS{dualStack: dualStack}
+		ctx := service.ContextWith[adapter.DNSRouter](context.Background(), dns)
+		ctx = service.ContextWithPtr(ctx, history)
+		delay, err := URLTest(ctx, "http://probe.example:"+port+"/generate_204", detour)
+		if err != nil || delay == 0 {
+			t.Fatalf("delay test failed: %d, %v", delay, err)
+		}
+		if dns.lookups != 1 {
+			t.Fatalf("DNS lookups = %d, want 1", dns.lookups)
+		}
+		capabilities, loaded := history.LoadIPStack("node")
+		if !loaded {
+			t.Fatal("missing capability result")
+		}
+		if dualStack {
+			if capabilities.TCP.IPv4 != adapter.IPStackAvailable || capabilities.TCP.IPv6 != adapter.IPStackUnavailable {
+				t.Fatalf("unexpected TCP capabilities: %+v", capabilities.TCP)
+			}
+		} else if capabilities != (adapter.OutboundIPStack{}) {
+			t.Fatalf("single-stack URL enabled capability detection: %+v", capabilities)
+		}
+		if capabilities.UDP != (adapter.IPStackCapabilities{}) {
+			t.Fatal("plain HTTP was treated as a UDP probe")
+		}
+	}
+}
