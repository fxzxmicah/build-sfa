From be4b2ccf2aecee5391eb858ca6be6355cf255bfd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E4=B8=96=E7=95=8C?= <i@sekai.icu>
Date: Fri, 27 Nov 2026 19:43:34 +0800
Subject: [PATCH] Fix oomprofile heap snapshots with Go 1.27

(cherry picked from commit 89d4eea09ce3d874d2ca6099b4548eb641d27a7b)
---
 .../libbox/internal/oomprofile/oomprofile.go   | 18 ++++--------------
 .../libbox/internal/oomprofile/record_go126.go | 17 +++++++++++++++++
 .../libbox/internal/oomprofile/record_go127.go | 17 +++++++++++++++++
 3 files changed, 38 insertions(+), 14 deletions(-)
 create mode 100644 experimental/libbox/internal/oomprofile/record_go126.go
 create mode 100644 experimental/libbox/internal/oomprofile/record_go127.go

diff --git a/experimental/libbox/internal/oomprofile/oomprofile.go b/experimental/libbox/internal/oomprofile/oomprofile.go
index 5d35533..a333e9e 100644
--- a/experimental/libbox/internal/oomprofile/oomprofile.go
+++ b/experimental/libbox/internal/oomprofile/oomprofile.go
@@ -18,17 +18,7 @@ type stackRecord struct {
 	Stack []uintptr
 }
 
-type memProfileRecord struct {
-	AllocBytes, FreeBytes     int64
-	AllocObjects, FreeObjects int64
-	Stack                     []uintptr
-}
-
-func (r *memProfileRecord) InUseBytes() int64 {
-	return r.AllocBytes - r.FreeBytes
-}
-
-func (r *memProfileRecord) InUseObjects() int64 {
+func (r *memProfileRecord) inUseObjects() int64 {
 	return r.AllocObjects - r.FreeObjects
 }
 
@@ -336,12 +326,12 @@ func writeHeapProto(w io.Writer, profile []memProfileRecord, rate int64, default
 			hideRuntime = false
 		}
 
-		values[0], values[1] = scaleHeapSample(record.AllocObjects, record.AllocBytes, rate)
-		values[2], values[3] = scaleHeapSample(record.InUseObjects(), record.InUseBytes(), rate)
+		values[0], values[1] = scaleHeapSample(record.AllocObjects, record.allocBytes(), rate)
+		values[2], values[3] = scaleHeapSample(record.inUseObjects(), record.inUseBytes(), rate)
 
 		var blockSize int64
 		if record.AllocObjects > 0 {
-			blockSize = record.AllocBytes / record.AllocObjects
+			blockSize = record.allocBytes() / record.AllocObjects
 		}
 		builder.pbSample(values, locs, func() {
 			if blockSize != 0 {
diff --git a/experimental/libbox/internal/oomprofile/record_go126.go b/experimental/libbox/internal/oomprofile/record_go126.go
new file mode 100644
index 0000000..df85df0
--- /dev/null
+++ b/experimental/libbox/internal/oomprofile/record_go126.go
@@ -0,0 +1,17 @@
+//go:build (darwin || linux || windows) && !go1.27
+
+package oomprofile
+
+type memProfileRecord struct {
+	AllocBytes, FreeBytes     int64
+	AllocObjects, FreeObjects int64
+	Stack                     []uintptr
+}
+
+func (r *memProfileRecord) allocBytes() int64 {
+	return r.AllocBytes
+}
+
+func (r *memProfileRecord) inUseBytes() int64 {
+	return r.AllocBytes - r.FreeBytes
+}
diff --git a/experimental/libbox/internal/oomprofile/record_go127.go b/experimental/libbox/internal/oomprofile/record_go127.go
new file mode 100644
index 0000000..2f4f4b6
--- /dev/null
+++ b/experimental/libbox/internal/oomprofile/record_go127.go
@@ -0,0 +1,17 @@
+//go:build (darwin || linux || windows) && go1.27
+
+package oomprofile
+
+type memProfileRecord struct {
+	ObjectSize                int64
+	AllocObjects, FreeObjects int64
+	Stack                     []uintptr
+}
+
+func (r *memProfileRecord) allocBytes() int64 {
+	return r.AllocObjects * r.ObjectSize
+}
+
+func (r *memProfileRecord) inUseBytes() int64 {
+	return r.inUseObjects() * r.ObjectSize
+}
-- 
2.56.0

