 ) {
     constructor(item: OutboundGroupItem) : this(
         item.tag,
@@ -41,9 +43,33 @@ data class GroupItem(
         Libbox.proxyDisplayType(item.type),
         item.urlTestTime,
         item.urlTestDelay,
+        IPStackStatus.from(item.getTCPIPv4(), item.getUDPIPv4()),
+        IPStackStatus.from(item.getTCPIPv6(), item.getUDPIPv6()),
     )
 }
 
+enum class IPStackStatus {
+    Unknown,
+    Available,
+    Partial,
+    Unavailable,
+    ;
+
+    companion object {
+        fun from(tcp: Int, udp: Int): IPStackStatus = when {
+            !Libbox.IPStackUDPProbe -> when (tcp) {
+                Libbox.IPStackAvailable.toInt() -> Available
+                Libbox.IPStackUnavailable.toInt() -> Unavailable
+                else -> Unknown
+            }
+            tcp == Libbox.IPStackUnknown.toInt() || udp == Libbox.IPStackUnknown.toInt() -> Unknown
+            tcp == Libbox.IPStackAvailable.toInt() && udp == Libbox.IPStackAvailable.toInt() -> Available
+            tcp == Libbox.IPStackUnavailable.toInt() && udp == Libbox.IPStackUnavailable.toInt() -> Unavailable
+            else -> Partial
+        }
+    }
+}
+
