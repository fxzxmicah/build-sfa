index 0000000..ddbce79
--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/compose/feature/AppFeature.kt
@@ -0,0 +1,82 @@
+package io.nekohasekai.sfa.compose.feature
+
+import androidx.compose.foundation.clickable
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.outlined.Route
+import androidx.compose.material3.Card
+import androidx.compose.material3.CardDefaults
+import androidx.compose.material3.Icon
+import androidx.compose.material3.ListItem
+import androidx.compose.material3.ListItemDefaults
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clip
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.vector.ImageVector
+import androidx.compose.ui.unit.dp
+import androidx.navigation.NavController
+import androidx.navigation.NavGraphBuilder
+import io.nekohasekai.sfa.compose.component.listItemShape
+
+interface AppFeature {
+    val unreadCount: Int get() = 0
+    val hasError: Boolean get() = false
+
+    fun subscribe() {}
+
+    fun cancel() {}
+
+    @Composable
+    fun Content(navController: NavController) {}
+
+    fun routes(builder: NavGraphBuilder, navController: NavController) {}
+
+    @Composable
+    fun Settings(navController: NavController) {}
+}
+
+object EmptyFeature : AppFeature
+
+data class FeatureEntry(val label: String, val route: String)
+
+@Composable
+fun FeatureSection(
+    navController: NavController,
+    entries: List<FeatureEntry>,
+    title: String,
+    icon: ImageVector = Icons.Outlined.Route,
+) {
+    if (entries.isEmpty()) return
+    Text(
+        text = title,
+        style = MaterialTheme.typography.labelLarge,
+        color = MaterialTheme.colorScheme.primary,
+        modifier = Modifier.padding(horizontal = 32.dp, vertical = 8.dp),
+    )
+    Card(
+        modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+        colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+    ) {
+        entries.forEachIndexed { index, entry ->
+            ListItem(
+                headlineContent = { Text(entry.label, style = MaterialTheme.typography.bodyLarge) },
+                leadingContent = { Icon(icon, contentDescription = null, tint = MaterialTheme.colorScheme.primary) },
+                modifier = Modifier.clip(listItemShape(index, entries.size)).clickable { navController.navigate(entry.route) },
+                colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+            )
+        }
+    }
+}
+
+@Composable
+fun rememberAppFeatures(): List<AppFeature> =
+    listOf(
+        rememberTailscaleFeature(),
+        rememberOpenConnectFeature(),
+        rememberOpenVPNFeature(),
+        rememberUSBIPFeature(),
+    )
