@@ -0,0 +1,63 @@
+package io.nekohasekai.sfa.compose.feature
+
+import android.net.Uri
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.res.stringResource
+import androidx.lifecycle.viewmodel.compose.viewModel
+import androidx.navigation.NavController
+import androidx.navigation.NavGraphBuilder
+import androidx.navigation.NavType
+import androidx.navigation.compose.composable
+import androidx.navigation.navArgument
+import io.nekohasekai.sfa.R
+import io.nekohasekai.sfa.compose.navigation.slideInFromLeft
+import io.nekohasekai.sfa.compose.navigation.slideInFromRight
+import io.nekohasekai.sfa.compose.navigation.slideOutToLeft
+import io.nekohasekai.sfa.compose.navigation.slideOutToRight
+import io.nekohasekai.sfa.compose.screen.tools.OpenConnectEndpointScreen
+import io.nekohasekai.sfa.compose.screen.tools.OpenConnectStatusViewModel
+
+@Composable
+fun rememberOpenConnectFeature(): AppFeature {
+    val viewModel: OpenConnectStatusViewModel = viewModel()
+    val state by viewModel.uiState.collectAsState()
+    return object : AppFeature {
+        override fun subscribe() = viewModel.subscribe()
+        override fun cancel() = viewModel.cancel()
+
+        @Composable
+        override fun Content(navController: NavController) = FeatureSection(
+            navController,
+            state.endpoints.map {
+                FeatureEntry(
+                    if (state.endpoints.size == 1) {
+                        stringResource(R.string.openconnect)
+                    } else {
+                        stringResource(R.string.openconnect_with_tag, it.endpointTag)
+                    },
+                    "tools/openconnect/${Uri.encode(it.endpointTag)}",
+                )
+            },
+            title = stringResource(R.string.tailscale_endpoints),
+        )
+
+        override fun routes(builder: NavGraphBuilder, navController: NavController) {
+            builder.composable(
+                "tools/openconnect/{endpointTag}",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                OpenConnectEndpointScreen(
+                    navController,
+                    viewModel,
+                    Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+        }
+    }
+}
