+fun cleanTailscaleCache() = TaildropFiles.cleanCache()
+
+fun taildropRoute(uri: Uri): String? {
+    if (uri.scheme != "sing-box") return null
+    val target = if (uri.isOpaque) Uri.parse("sing-box://" + uri.schemeSpecificPart) else uri
+    return target.takeIf { it.host == "taildrop" }
+        ?.getQueryParameter("endpoint")
+        ?.takeIf(String::isNotEmpty)
+        ?.let { "tools/tailscale/${Uri.encode(it)}/taildrop" }
+}
+
+@Composable
+fun rememberTailscaleFeature(): AppFeature {
+    val statusViewModel: TailscaleStatusViewModel = viewModel()
+    val sshViewModel: TailscaleSSHSharedViewModel = viewModel()
+    val state by statusViewModel.uiState.collectAsState()
+    val sends by TaildropSendManager.sessions.collectAsState()
+    return object : AppFeature {
+        override val unreadCount = state.endpoints.sumOf { it.unreadFileCount }
+        override val hasError = sends.any { it.errorMessage != null }
+
+        override fun subscribe() = statusViewModel.subscribe()
+        override fun cancel() = statusViewModel.cancel()
+
+        @OptIn(ExperimentalFoundationApi::class)
+        @Composable
+        override fun Content(navController: NavController) {
+            val endpoints = state.endpoints
+            if (endpoints.isNotEmpty()) {
+                Text(
+                    text = stringResource(R.string.tailscale_endpoints),
+                    style = MaterialTheme.typography.labelLarge,
+                    color = MaterialTheme.colorScheme.primary,
+                    modifier = Modifier.padding(horizontal = 32.dp, vertical = 8.dp),
+                )
+                Card(
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 16.dp),
+                    colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceContainer),
+                ) {
+                    endpoints.forEachIndexed { index, endpoint ->
+                        var showSSHMenu by remember { mutableStateOf(false) }
+                        val sshPeers = remember(endpoint) {
+                            endpoint.userGroups.flatMap { it.peers }.filter { peer ->
+                                peer.online && peer.sshHostKeys.isNotEmpty() &&
+                                    peer.tailscaleIPs.isNotEmpty() && peer.id != endpoint.selfPeer?.id
+                            }
+                        }
+                        Box {
+                            ListItem(
+                                headlineContent = {
+                                    Text(
+                                        if (endpoints.size == 1) {
+                                            stringResource(R.string.tailscale)
+                                        } else {
+                                            stringResource(R.string.tailscale_with_tag, endpoint.endpointTag)
+                                        },
+                                        style = MaterialTheme.typography.bodyLarge,
+                                    )
+                                },
+                                leadingContent = {
+                                    Icon(
+                                        imageVector = Icons.Outlined.Hub,
+                                        contentDescription = null,
+                                        tint = MaterialTheme.colorScheme.primary,
+                                    )
+                                },
+                                trailingContent = {
+                                    if (sends.any { it.endpointTag == endpoint.endpointTag && it.errorMessage != null }) {
+                                        Badge(containerColor = MaterialTheme.colorScheme.error) {
+                                            Text("!")
+                                        }
+                                    } else if (endpoint.unreadFileCount > 0) {
+                                        Badge(containerColor = MaterialTheme.colorScheme.primary) {
+                                            Text("${endpoint.unreadFileCount}")
+                                        }
+                                    }
+                                },
+                                modifier = Modifier
+                                    .clip(listItemShape(index, endpoints.size))
+                                    .combinedClickable(
+                                        onClick = {
+                                            navController.navigate("tools/tailscale/${Uri.encode(endpoint.endpointTag)}")
+                                        },
+                                        onLongClick = {
+                                            if (sshPeers.isNotEmpty()) {
+                                                showSSHMenu = true
+                                            }
+                                        },
+                                    ),
+                                colors = ListItemDefaults.colors(containerColor = Color.Transparent),
+                            )
+                            DropdownMenu(
+                                expanded = showSSHMenu,
+                                onDismissRequest = { showSSHMenu = false },
+                            ) {
+                                if (sshPeers.size == 1) {
+                                    DropdownMenuItem(
+                                        text = { Text(stringResource(R.string.tailscale_ssh_connect)) },
+                                        leadingIcon = {
+                                            Icon(Icons.Default.Terminal, contentDescription = null)
+                                        },
+                                        onClick = {
+                                            showSSHMenu = false
+                                            handleSSHNavigation(
+                                                navController,
+                                                sshViewModel,
+                                                sshPeers[0],
+                                                endpoint.endpointTag,
+                                            )
+                                        },
+                                    )
+                                } else {
+                                    DropdownMenuItem(
+                                        text = { Text(stringResource(R.string.tailscale_ssh_connect)) },
+                                        leadingIcon = {
+                                            Icon(Icons.Default.Terminal, contentDescription = null)
+                                        },
+                                        enabled = false,
+                                        onClick = {},
+                                    )
+                                    sshPeers.forEach { peer ->
+                                        DropdownMenuItem(
+                                            text = { Text(peer.hostName) },
+                                            onClick = {
+                                                showSSHMenu = false
+                                                handleSSHNavigation(
+                                                    navController,
+                                                    sshViewModel,
+                                                    peer,
+                                                    endpoint.endpointTag,
+                                                )
+                                            },
+                                        )
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        @Composable
+        override fun Settings(navController: NavController) = FeatureSection(
+            navController,
+            listOf(FeatureEntry(stringResource(R.string.tailscale_terminal_config), "settings/tailscale/terminal_config")),
+            title = stringResource(R.string.tailscale),
+            icon = Icons.Default.Terminal,
+        )
+
+        override fun routes(builder: NavGraphBuilder, navController: NavController) {
+            builder.composable(
+                "tools/tailscale/{endpointTag}",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscaleEndpointScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    sshSharedViewModel = sshViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/taildrop",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TaildropInboxScreen(
+                    navController = navController,
+                    viewModel = viewModel<TaildropViewModel>(),
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/exit_node",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscaleExitNodePickerScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/peer/{peerId}",
+                arguments = listOf(
+                    navArgument("endpointTag") { type = NavType.StringType },
+                    navArgument("peerId") { type = NavType.StringType },
+                ),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscalePeerScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                    peerId = Uri.decode(entry.arguments?.getString("peerId") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/peer/{peerId}/ssh",
+                arguments = listOf(
+                    navArgument("endpointTag") { type = NavType.StringType },
+                    navArgument("peerId") { type = NavType.StringType },
+                ),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscaleSSHPromptScreen(
+                    navController = navController,
+                    sharedViewModel = sshViewModel,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                    peerId = Uri.decode(entry.arguments?.getString("peerId") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/peer/{peerId}/terminal",
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) {
+                TailscaleSSHTerminalScreen(navController, sshViewModel, statusViewModel)
+            }
+            builder.composable(
+                "settings/tailscale/terminal_config",
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) {
+                TailscaleTerminalConfigScreen(navController)
+            }
+            builder.composable(
+                "settings/tailscale/theme_picker/{isDark}",
+                arguments = listOf(navArgument("isDark") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscaleThemePickerScreen(navController, entry.arguments?.getString("isDark") == "true")
+            }
+            builder.composable(
+                "settings/tailscale/config_editor/{isDark}",
+                arguments = listOf(navArgument("isDark") { type = NavType.StringType }),
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) { entry ->
+                TailscaleGhosttyConfigEditorScreen(navController, entry.arguments?.getString("isDark") == "true")
+            }
+            builder.composable(
+                "settings/tailscale/font_picker",
+                enterTransition = slideInFromRight,
+                exitTransition = slideOutToLeft,
+                popEnterTransition = slideInFromLeft,
+                popExitTransition = slideOutToRight,
+            ) {
+                TailscaleFontPickerScreen(navController)
+            }
+        }
+    }
+}
