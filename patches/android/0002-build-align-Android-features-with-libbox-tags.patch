--- /dev/null
+++ b/app/src/main/java/io/nekohasekai/sfa/compose/component/ListItemShape.kt
@@ -0,0 +1,11 @@
+package io.nekohasekai.sfa.compose.component
+
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.ui.unit.dp
+
+internal fun listItemShape(index: Int, count: Int): RoundedCornerShape = when {
+    count == 1 -> RoundedCornerShape(12.dp)
+    index == 0 -> RoundedCornerShape(topStart = 12.dp, topEnd = 12.dp)
+    index == count - 1 -> RoundedCornerShape(bottomStart = 12.dp, bottomEnd = 12.dp)
+    else -> RoundedCornerShape(0.dp)
+}
