+import io.nekohasekai.sfa.compose.screen.settings.TailscaleGhosttyConfigEditorScreen
+import io.nekohasekai.sfa.compose.screen.settings.TailscaleTerminalConfigScreen
+import io.nekohasekai.sfa.compose.screen.settings.TailscaleThemePickerScreen
+import io.nekohasekai.sfa.compose.screen.tools.TaildropInboxScreen
+import io.nekohasekai.sfa.compose.screen.tools.TaildropFiles
+import io.nekohasekai.sfa.compose.screen.tools.TaildropSendManager
+import io.nekohasekai.sfa.compose.screen.tools.TaildropViewModel
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleEndpointScreen
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleExitNodePickerScreen
+import io.nekohasekai.sfa.compose.screen.tools.TailscalePeerScreen
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleSSHPromptScreen
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleSSHSharedViewModel
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleSSHTerminalScreen
+import io.nekohasekai.sfa.compose.screen.tools.TailscaleStatusViewModel
+
+fun cleanTailscaleCache() = TaildropFiles.cleanCache()
+
+@Composable
+fun rememberTailscaleFeature(): AppFeature {
+    val statusViewModel: TailscaleStatusViewModel = viewModel()
+    val sshViewModel: TailscaleSSHSharedViewModel = viewModel()
+    val state by statusViewModel.uiState.collectAsState()
+    val sends by TaildropSendManager.sessions.collectAsState()
+    return object : AppFeature {
+        override val unreadCount = state.endpoints.sumOf { it.unreadFileCount }
+        override val hasError = sends.any { it.errorMessage != null }
+
+        override fun subscribe() = statusViewModel.subscribe()
+        override fun cancel() = statusViewModel.cancel()
+
+        @Composable
+        override fun Content(navController: NavController) = FeatureSection(
+            navController,
+            state.endpoints.map { FeatureEntry("Tailscale: ${it.endpointTag}", "tools/tailscale/${Uri.encode(it.endpointTag)}") },
+            Icons.Outlined.Hub,
+        )
+
+        @Composable
+        override fun Settings(navController: NavController) = FeatureSection(
+            navController,
+            listOf(FeatureEntry("Tailscale terminal", "settings/tailscale/terminal_config")),
+        )
+
+        override fun routes(builder: NavGraphBuilder, navController: NavController) {
+            builder.composable(
+                "tools/tailscale/{endpointTag}",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+            ) { entry ->
+                TailscaleEndpointScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    sshSharedViewModel = sshViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/taildrop",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+            ) { entry ->
+                TaildropInboxScreen(
+                    navController = navController,
+                    viewModel = viewModel<TaildropViewModel>(),
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/exit_node",
+                arguments = listOf(navArgument("endpointTag") { type = NavType.StringType }),
+            ) { entry ->
+                TailscaleExitNodePickerScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/peer/{peerId}",
+                arguments = listOf(
+                    navArgument("endpointTag") { type = NavType.StringType },
+                    navArgument("peerId") { type = NavType.StringType },
+                ),
+            ) { entry ->
+                TailscalePeerScreen(
+                    navController = navController,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                    peerId = Uri.decode(entry.arguments?.getString("peerId") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/tailscale/{endpointTag}/peer/{peerId}/ssh",
+                arguments = listOf(
+                    navArgument("endpointTag") { type = NavType.StringType },
+                    navArgument("peerId") { type = NavType.StringType },
+                ),
+            ) { entry ->
+                TailscaleSSHPromptScreen(
+                    navController = navController,
+                    sharedViewModel = sshViewModel,
+                    viewModel = statusViewModel,
+                    endpointTag = Uri.decode(entry.arguments?.getString("endpointTag") ?: return@composable),
+                    peerId = Uri.decode(entry.arguments?.getString("peerId") ?: return@composable),
+                )
+            }
+            builder.composable("tools/tailscale/{endpointTag}/peer/{peerId}/terminal") {
+                TailscaleSSHTerminalScreen(navController, sshViewModel, statusViewModel)
+            }
+            builder.composable("settings/tailscale/terminal_config") {
+                TailscaleTerminalConfigScreen(navController)
+            }
+            builder.composable(
+                "settings/tailscale/theme_picker/{isDark}",
+                arguments = listOf(navArgument("isDark") { type = NavType.StringType }),
+            ) { entry ->
+                TailscaleThemePickerScreen(navController, entry.arguments?.getString("isDark") == "true")
+            }
+            builder.composable(
+                "settings/tailscale/config_editor/{isDark}",
+                arguments = listOf(navArgument("isDark") { type = NavType.StringType }),
+            ) { entry ->
+                TailscaleGhosttyConfigEditorScreen(navController, entry.arguments?.getString("isDark") == "true")
+            }
+            builder.composable("settings/tailscale/font_picker") {
+                TailscaleFontPickerScreen(navController)
+            }
+        }
+    }
+}
