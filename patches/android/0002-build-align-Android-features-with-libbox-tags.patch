+package io.nekohasekai.sfa.compose.feature
+
+import android.net.Uri
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Usb
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.viewmodel.compose.viewModel
+import androidx.navigation.NavController
+import androidx.navigation.NavGraphBuilder
+import androidx.navigation.NavType
+import androidx.navigation.compose.composable
+import androidx.navigation.navArgument
+import io.nekohasekai.sfa.compose.screen.usbip.USBIPDeviceDetailScreen
+import io.nekohasekai.sfa.compose.screen.usbip.USBIPServerScreen
+import io.nekohasekai.sfa.compose.screen.usbip.USBIPStatusViewModel
+
+@Composable
+fun rememberUSBIPFeature(): AppFeature {
+    val viewModel: USBIPStatusViewModel = viewModel()
+    val state by viewModel.uiState.collectAsState()
+    return object : AppFeature {
+        override fun subscribe() = viewModel.subscribe()
+        override fun cancel() = viewModel.cancel()
+
+        @Composable
+        override fun Content(navController: NavController) = FeatureSection(
+            navController,
+            state.servers.map { FeatureEntry("USB/IP: ${it.serverTag}", "tools/usbip/${Uri.encode(it.serverTag)}") },
+            Icons.Default.Usb,
+        )
+
+        override fun routes(builder: NavGraphBuilder, navController: NavController) {
+            builder.composable(
+                "tools/usbip/{serverTag}",
+                arguments = listOf(navArgument("serverTag") { type = NavType.StringType }),
+            ) { entry ->
+                USBIPServerScreen(
+                    navController,
+                    viewModel,
+                    Uri.decode(entry.arguments?.getString("serverTag") ?: return@composable),
+                )
+            }
+            builder.composable(
+                "tools/usbip/{serverTag}/device/{deviceKey}",
+                arguments = listOf(
+                    navArgument("serverTag") { type = NavType.StringType },
+                    navArgument("deviceKey") { type = NavType.StringType },
+                ),
+            ) { entry ->
+                USBIPDeviceDetailScreen(
+                    navController,
+                    viewModel,
+                    Uri.decode(entry.arguments?.getString("serverTag") ?: return@composable),
+                    Uri.decode(entry.arguments?.getString("deviceKey") ?: return@composable),
+                )
+            }
+        }
+    }
+}
